# Copy to apps/web/.env and fill in values
# cp apps/web/.env.example apps/web/.env

# MongoDB (database name must be streemo)
MONGODB_URI="mongodb://user:pass@host:27017/streemo?authSource=admin"

# Auth — use long random strings in production
AUTH_SECRET="change-me-to-a-long-random-string"
DEVICE_TOKEN_SECRET="change-me-device-token-secret"

# Media storage: local | s3
STORAGE_MODE="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="streemo"

# App
APP_URL="http://localhost:3000"
PORT=3000
HOSTNAME="0.0.0.0"

SEED_EMAIL="admin@streemo.local"
SEED_PASSWORD="admin123"
