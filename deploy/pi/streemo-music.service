[Unit]
Description=Streemo music player
After=streemo-agent.service sound.target
Wants=streemo-agent.service

[Service]
Type=simple
User=streemo
Group=streemo
Environment=STREEMO_STATE=/var/lib/streemo/state
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/opt/streemo/venv/bin/streemo-music
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
